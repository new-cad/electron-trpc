{
  "name": "@new-cad/electron-trpc",
  "description": "Electron support for tRPC",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/new-cad/electron-trpc.git"
  },
  "bugs": {
    "url": "https://github.com/new-cad/electron-trpc/issues"
  },
  "keywords": [
    "electron",
    "trpc",
    "ipc",
    "rpc",
    "typescript"
  ],
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "require": "./dist/renderer.cjs",
      "import": "./dist/renderer.mjs"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "main.d.ts",
    "renderer.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build -c src/main/vite.config.mts && vite build -c src/renderer/vite.config.mts && corepack pnpm build:types",
    "build:types": "dts-bundle-generator --config ./dts-bundle-generator.config.ts && corepack pnpm run copy:types",
    "copy:readme": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "copy:types": "node -e \"for (const file of ['main.d.ts', 'renderer.d.ts']) require('node:fs').copyFileSync('dist/' + file, file)\"",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:electron": "node scripts/run-electron-tests.mjs",
    "prepublishOnly": "corepack pnpm copy:readme && corepack pnpm build",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "@types/ws": "8.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "dts-bundle-generator": "9.5.1",
    "electron": "44.8.0",
    "superjson": "^2.2.6",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "electron": ">=42.0.0"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}
